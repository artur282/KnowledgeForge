# KnowledgeForge — Dokploy Environment Variables
# Copy this to .env in Dokploy's Environment tab

# === DATABASE ===
POSTGRES_USER=knowledgeforge
POSTGRES_PASSWORD=<CHANGE_ME: generate with `openssl rand -hex 24`>
POSTGRES_DB=knowledgeforge

# === ELASTICSEARCH ===
ELASTIC_PASSWORD=<CHANGE_ME: generate with `openssl rand -hex 24`>

# === LANGFUSE ===
LANGFUSE_DB_USER=langfuse
LANGFUSE_DB_PASSWORD=<CHANGE_ME: generate with `openssl rand -hex 24`>
LANGFUSE_DB_NAME=langfuse
NEXTAUTH_SECRET=<CHANGE_ME: generate with `openssl rand -hex 32`>
SALT=<CHANGE_ME: generate with `openssl rand -hex 16`>
LANGFUSE_URL=https://langfuse.yourdomain.com

# === OPENAI / LLM ===
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=nvidia/nemotron-3-nano-30b-a3b:free
EMBEDDING_MODEL=text-embedding-3-small

# === APP ===
COHERE_API_KEY=
USE_SEMANTIC_SPLITTER=false
CHUNK_SIZE=500
CHUNK_OVERLAP=50
